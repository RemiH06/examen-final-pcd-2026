# Copia este archivo como .env y reemplaza los valores ficticios.
# Credenciales de Databricks (las usan el flujo de entrenamiento y la API; la UI no).
DATABRICKS_HOST=https://dbc-00000000-0000.cloud.databricks.com
DATABRICKS_TOKEN=dapi-valor-ficticio

# Modelo registrado en Unity Catalog y alias que la API resuelve al iniciar.
MODEL_NAME=workspace.default.pcd_2026_examen_sms_remih06
MODEL_ALIAS=champion

# Dirección de la API que consulta la UI (en Compose se sobrescribe con el nombre del servicio).
API_URL=http://127.0.0.1:8060
